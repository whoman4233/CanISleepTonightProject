  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Rule\n1. \uC804\uC218\uC870\uC0AC : \uBAA8\uB4E0 \uAC10\uBC29\uC5D0 \uBE60\uC9D0\uC5C6\uC774
    \uC785\uC7A5\uD558\uC5EC \uC0C1\uD0DC\uB97C \uD655\uC778\uD560 \uAC83\n2. \uC815\uBC00\uC218\uC0C9
    : \uC758\uC2EC\uC2A4\uB7EC\uC6B4 \uBB3C\uAC74\uC774\uB098 \uD754\uC801\uC740
    \uBC18\uB4DC\uC2DC \uC790\uC138\uD788 \uCCB4\uD06C\uD560 \uAC83\n3. \uC989\uAC01\uC870\uCE58
    : \uD0C8\uC625/\uD3ED\uB3D9 \uBAA8\uC758 \uD754\uC801, \uAE08\uC9C0 \uBB3C\uD488
    \uBC1C\uACAC \uC2DC \uC8C4\uC218\uB97C \uCCA0\uC800\uD788 \uAD50\uC721\uD560
    \uAC83(\uBB34\uB825\uC9C4\uC555)\n4. \uBB3C\uD488 \uC555\uC218 : \uAE08\uC9C0
    \uBB3C\uD488\uC774\uB098 \uBB34\uAE30 \uC885\uB958 \uBC1C\uACAC \uC2DC \uBC18\uB4DC\uC2DC
    \uC555\uC218\uD560 \uAC83!\n5. \uACFC\uC789 \uAE08\uC9C0 : \uBB38\uC81C\uAC00
    \uC5C6\uB294 \uC8C4\uC218\uC5D0 \uB300\uD55C \uACFC\uC789 \uC9C4\uC555\uC740
    \uC5C4\uAE08\uD55C\uB2E4.\n6. \uBCF4\uACE0 \uC791\uC131 : \uADFC\uBB34 \uC2DC\uAC04
    \uB0B4\uC5D0 \uBC18\uB4DC\uC2DC \uC0AC\uBB34\uC2E4\uB85C \uBCF5\uADC0\uD558\uC5EC
    \uBCF4\uACE0\uC11C\uB97C \uC791\uC131\uD560 \uAC83"
