    text: Today's Mission
    info: "\uC624\uB298\uC758 \uBBF8\uC158"
  - id: Utxt_KR_M00_01
    text: "\uC624\uB298\uC758 \uBBF8\uC158"
    info: "\uC624\uB298\uC758 \uBBF8\uC158 \uCD5C\uC0C1\uB2E8 \uD14D\uC2A4\uD2B8"
  - id: Utxt_KR_M00_02
    text: THE OFFICIAL LOG
    info: "\uC131\uACF5 UI \uCD5C\uC0C1\uB2E8 \uD14D\uC2A4\uD2B8"
  - id: Utxt_KR_M00_03
    text: "\uADFC\uBB34\uC790 \uBA85: Etan Walker"
    info: "\uADFC\uBB34\uC790 \uBA85"
  - id: Utxt_KR_M00_04
    text: "\uBB34\uC0AC\uACE0 \uB0A0\uC9DC:"
    info: "\uBB34\uC0AC\uACE0 \uB0A0\uC9DC"
  - id: Utxt_KR_M00_05
    text: "\uBBF8\uC158 \uACB0\uACFC: \uC131\uACF5"
    info: "\uBBF8\uC158 \uACB0\uACFC"
  - id: Utxt_KR_M00_06
    text: "\uB0B4\uC77C \uB2E4\uC2DC \uBD59\uACA0\uC2B5\uB2C8\uB2E4."
    info: "\uACC4\uC57D \uC5F0\uC7A5 \uB3C4\uC7A5 \uC0C1\uB2E8"
  - id: Utxt_KR_M00_07
    text: "\uAD50\uB3C4\uC18C\uC7A5 \uBC31"
    info: "\uACC4\uC57D \uC5F0\uC7A5 \uB3C4\uC7A5 \uD558\uB2E8"
  - id: Utxt_KR_M00_08
    text: "\uB2E4\uC74C \uB0A0\uB85C \uC774\uB3D9"
    info: "\uB2E4\uC74C \uB0A0 \uC774\uB3D9 \uBC84\uD2BC"
  - id: Utxt_KR_M00_09
    text: "\uD0C0\uC774\uD2C0\uB85C \uC774\uB3D9"
    info: "\uD0C0\uC774\uD2C0 \uC774\uB3D9 \uBC84\uD2BC"
  - id: Utxt_KR_M00_10
    text: NOTICE OF TERMINATION
    info: "\uC2E4\uD328 UI \uCD5C\uC0C1\uB2E8 \uD14D\uC2A4\uD2B8"
  - id: Utxt_KR_M00_11
    text: "\uADFC\uBB34\uC790 \uBA85: Etan Walker"
    info: "\uADFC\uBB34\uC790 \uBA85"
  - id: Utxt_KR_M00_12
    text: "\uADFC\uBB34\uC77C \uC218:"
    info: "\uADFC\uBB34\uC77C \uC218"
  - id: Utxt_KR_M00_13
    text: "\uD574\uACE0 \uC0AC\uC720"
    info: "\uD574\uACE0 \uC0AC\uC720 \uD14D\uC2A4\uD2B8"
  - id: Utxt_KR_M00_14
    text: "\uC0C1\uAE30 \uC0AC\uC720\uB85C \uADC0\uD558\uB97C \uD574\uACE0\uD569\uB2C8\uB2E4."
    info: "\uADC0\uD558\uB97C \uD574\uACE0\uD569\uB2C8\uB2E4."
  - id: Utxt_KR_M00_15
    text: "\uD574\uACE0\uB97C \uD1B5\uC9C0\uD569\uB2C8\uB2E4"
    info: "\uD574\uACE0 \uD1B5\uC9C0 \uB3C4\uC7A5 \uC0C1\uB2E8"
  - id: Utxt_KR_M00_16
    text: "\uAD50\uB3C4\uC18C\uC7A5 \uBC31"
    info: "\uD574\uACE0 \uD1B5\uC9C0 \uB3C4\uC7A5 \uD558\uB2E8"
  - id: Utxt_KR_M00_17
    text: "\uADFC\uBB34 \uC7AC\uC2DC\uC791"
    info: "\uADFC\uBB34 \uC7AC\uC2DC\uC791 \uBC84\uD2BC"
  - id: Utxt_KR_M00_18
    text: "\uD0C0\uC774\uD2C0\uB85C \uC774\uB3D9"
    info: "\uD0C0\uC774\uD2C0 \uC774\uB3D9 \uBC84\uD2BC"
  - id: Utxt_KR_Pause_01
    text: "\uC5C5\uBB34 \uC77C\uC2DC \uC911\uB2E8"
    info: "\uC77C\uC2DC \uC815\uC9C0 \uCC3D \uBB38\uAD6C"
  - id: Utxt_KR_Pause_02
    text: "\uC5C5\uBB34 \uC7AC\uAC1C"
    info: "\uACC4\uC18D\uD558\uAE30 \uBC84\uD2BC"
  - id: Utxt_KR_Pause_03
    text: "\uC5C5\uBB34 \uC911\uB2E8"
    info: "\uD0C0\uC774\uD2C0 \uC774\uB3D9 \uBC84\uD2BC"
  - id: Utxt_KR_Pause_04
    text: "\uD658\uACBD \uC124\uC815"
    info: "\uD658\uACBD \uC124\uC815 \uBC84\uD2BC"
  - id: Utxt_KR_Inspection_01
    text: "\uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD \uBC84\uD2BC\uC744 \uB204\uB978
      \uCC44\uB85C \uC774\uB3D9\uD558\uBA74 \uBB3C\uCCB4\uB97C \uD68C\uC804\uC2DC\uD0AC
      \uC218 \uC788\uC2B5\uB2C8\uB2E4"
    info: "\uC0C1\uC138\uBCF4\uAE30 \uC0C1\uB2E8 \uC548\uB0B4 \uBB38\uAD6C(\uD074\uB9AD
      x)"
  - id: Utxt_KR_Inspection_02
    text: "\uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD \uBC84\uD2BC\uC744 \uB5C4 \uACBD\uC6B0
      \uD68C\uC804\uC744 \uBA48\uCDA5\uB2C8\uB2E4."
    info: "\uC0C1\uC138\uBCF4\uAE30 \uC0C1\uB2E8 \uC548\uB0B4 \uBB38\uAD6C(\uD074\uB9AD
      o)"
  - id: Utxt_KR_Inspection_03
    text: "\uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC744 \uB20C\uB7EC \uBB3C\uCCB4\uC640
      \uC0C1\uD638\uC791\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    info: "\uBB3C\uCCB4 \uC544\uB798 \uC0C1\uD638\uC791\uC6A9 \uC548\uB0B4 \uBB38\uAD6C"
  - id: Utxt_KR_Inspection_04
    text: "E \uD0A4\uB97C \uB20C\uB7EC \uC0C1\uC138\uBCF4\uAE30 \uC885\uB8CC"
    info: "\uC0C1\uC138\uBCF4\uAE30 \uC885\uB8CC \uBB38\uAD6C"
  - id: Utxt_KR_GameOver_01
    text: "\uAC8C\uC784 \uC624\uBC84"
    info: "\uAC8C\uC784 \uC624\uBC84 \uBB38\uAD6C"
  - id: Utxt_KR_GameOver_02
    text: "\uADFC\uBB34 \uC7AC\uC2DC\uC791"
    info: "\uAC8C\uC784 \uC7AC\uC2DC\uC791 \uBC84\uD2BC"
  - id: Utxt_KR_GameOver_03
    text: "\uD0C0\uC774\uD2C0\uB85C \uC774\uB3D9"
    info: "\uD0C0\uC774\uD2C0 \uC774\uB3D9 \uBC84\uD2BC"
