%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b631211225048214fb47dd70a97c4c62, type: 3}
  m_Name: DialogueTextData
  m_EditorClassIdentifier: 
  textList:
  - key: DTxt_KR_T_01
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC654\uB098? \uB124\uAC00 \uC624\uB298\uBD80\uD130 \uAD6C\uB97C \uC2E0\uC785\uC774\uAD70."
    en: 
  - key: DTxt_KR_T_02
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC778\uC0C1\uC740\xB7\xB7\xB7 \uC4F8\uB9CC\uD558\uAD70. \uD558\uC9C0\uB9CC
      \uC911\uC694\uD55C \uAC74 \uADF8\uAC8C \uC544\uB2C8\uC57C."
    en: 
  - key: DTxt_KR_T_03
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uAD50\uB3C4\uAD00\uC73C\uB85C \uADFC\uBB34\uD560 \uB54C \uAC00\uC7A5 \uC911\uC694\uD55C
      \uAC74 \u2018\uC6B4\u2019\uC774\uB791 \u2018\uB208\uCE58\u2019\uB2E4."
    en: 
  - key: DTxt_KR_T_04
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC77C\uB2E8, \uC6B4\uC774 \uC815\uB9D0 \uC911\uC694\uD574. \uC0AC\uACE0\uAC00
      \uC548 \uB098\uC57C \uD558\uAC70\uB4E0."
    en: 
  - key: DTxt_KR_T_05
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC798 \uBD10, \uC5EC\uAE30 \uD654\uC774\uD2B8\uBCF4\uB4DC \uBCF4\uC774\uC9C0?
      \uBB34\uC0AC\uACE0 \uBA70\uCE60 \uCC28\uB77C\uACE0 \uC801\uD600 \uC788\uB098?"
    en: 
  - key: DTxt_KR_T_06
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uADF8\uB798. 0\uC77C\uC774\uB2E4. \uC5B4\uC81C\uB3C4 \uB108 \uAC19\uC740
      \uC560\uC1A1\uC774\uAC00 \uD55C \uB188 \uC2E4\uB824 \uB098\uAC14\uAC70\uB4E0."
    en: 
  - key: DTxt_KR_T_07
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC774 \uBE4C\uC5B4\uBA39\uC744 7\uAD6C\uC5ED\uC740 \uC0AC\uAC74 \uC0AC\uACE0\uAC00
      \uB04A\uC774\uC9C0 \uC54A\uC544."
    en: 
  - key: DTxt_KR_T_08
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uB9E4\uC77C \uC0AC\uACE0\uAC00 \uD130\uC9C0\uACE0, \uC774\uD2C0\uB9CC \uD3C9\uD654\uB85C\uC6CC\uB3C4
      \uC624\uB798 \uAC04 \uAC70\uC9C0."
    en: 
  - key: DTxt_KR_T_09
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uADF8\uB798\uC11C \uC6B0\uB9AC \uBAA9\uD45C\uB294 7\uC77C\uC774\uB2E4.
      \uB531 \uC77C\uC8FC\uC77C\uC774\uB77C\uACE0."
    en: 
  - key: DTxt_KR_T_10
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC624\uB298\uBD80\uD130 \uC0AC\uACE0 \uC5C6\uC774 7\uC77C\uC744 \uBC84\uD2F0\uBA74
      \uB10C \uC815\uADDC\uC9C1\uC774\uB2E4. \uD558\uC9C0\uB9CC"
    en: 
  - key: DTxt_KR_T_11
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uB2E8 \uD55C \uBC88\uC774\uB77C\uB3C4 \uC0AC\uACE0\uAC00 \uD130\uC9C0\uBA74
      \uB10C \uADF8\uB0A0\uB85C \uC9D0 \uC2F8\uC11C \uB098\uAC00\uB294 \uAC70\uC57C."
    en: 
  - key: DTxt_KR_T_12
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uADF8\uB9AC\uACE0 \uC6B0\uB9AC\uB294 \uB2E4\uC2DC 0\uC77C\uCC28\uBD80\uD130
      \uC2DC\uC791\uD558\uB294 \uAC70\uACE0. \uB0B4 \uB9D0 \uC774\uD574\uD588\uB098?"
    en: 
  - key: DTxt_KR_T_13
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC88B\uB2E4."
    en: 
  - key: DTxt_KR_T_14
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC77C\uB2E8 \uADFC\uBB34\uB97C \uC704\uD574 \uD544\uC694\uD55C \uAC83\uBD80\uD130
      \uCC59\uAE30\uC790\uACE0."
    en: 
  - key: DTxt_KR_T_15
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC77C\uB2E8 \uC9C4\uC555 \uBD09\uC744 \uC918\uC57C \uD558\uB294\uB370\xB7\xB7\xB7
      \uCE90\uBE44\uB2DB \uC55E\uC5D0 \uC0C1\uC790\uAC00 \uC313\uC5EC \uC788\uAD70."
    en: 
  - key: DTxt_KR_T_16
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC0C1\uC790 \uC55E\uC5D0\uC11C E \uD0A4\uB97C \uB204\uB974\uBA74 \uC0C1\uC790\uB97C
      \uB4E4 \uC218 \uC788\uACE0, \uB2E4\uC2DC E \uD0A4\uB97C \uB204\uB974\uBA74
      \uB0B4\uB824\uB193\uC744 \uC218 \uC788\uB2E4."
    en: 
  - key: DTxt_KR_T_17
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uB2E4\uB978 \uBB3C\uAC74\uC744 \uB4E4\uAC70\uB098 \uB0B4\uB824\uB193\uC744
      \uB54C\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uB85C \uD558\uBA74 \uB41C\uB2E4."
    en: 
  - key: DTxt_KR_T_18
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC790, \uC0C1\uC790\uB97C \uCE58\uC6E0\uC73C\uB2C8 E \uD0A4\uB97C \uB20C\uB7EC
      \uCE90\uBE44\uB2DB\uC744 \uC5F4\uACE0, \uADF8 \uC548\uC5D0 \uC788\uB294 \uC9C4\uC555
      \uBD09\uC744 \uD074\uB9AD\uD574\uC11C \uCC59\uACA8\uB77C."
    en: 
  - key: DTxt_KR_T_19
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uAD50\uB3C4\uAD00\uC774\uB77C\uBA74 \uC9C4\uC555 \uBD09\uC740 \uD544\uC218\uC9C0.
      \uC8C4\uC218 \uB188\uB4E4\uC740 \uB9D0\uB85C \uD574\uC11C\uB294 \uBABB \uC54C\uC544\uB4E3\uAC70\uB4E0."
    en: 
  - key: DTxt_KR_T_20
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uD0A4\uB97C \uB204\uB974\uBA74 \uACF5\uACA9\uD560
      \uC218 \uC788\uB2E4. \uC790, \uB098\uD55C\uD14C \uD55C \uBC88 \uD718\uB458\uB7EC\uBD10."
    en: 
  - key: DTxt_KR_T_21
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC0DD\uAC01\uBCF4\uB2E8 \uC81C\uBC95\uC774\uAD70. \uD2BC\uD2BC\uD55C \uB188\uB4E4\uB3C4
      \uB124, \uB2E4\uC12F \uB300\uBA74 \uC81C\uC555\uD560 \uC218 \uC788\uACA0\uC5B4."
    en: 
  - key: DTxt_KR_T_22
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uADF8\uB7F0\uB370 \uAD50\uB3C4\uC18C \uADFC\uBB34\uB294 \uBAB8\uB9CC \uC798
      \uC4F0\uBA74 \uB41C\uB2E4\uACE0 \uD574\uACB0\uB418\uB294 \uAC8C \uC544\uB2C8\uC57C."
    en: 
  - key: DTxt_KR_T_23
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC544\uAE4C \uB0B4\uAC00 \uC6B4\uC774\uB791 \uBB50\uAC00 \uC911\uC694\uD558\uB2E4\uACE0
      \uD588\uC9C0?"
    en: 
  - key: DTxt_KR_T_24
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uADF8\uB798, \uB208\uCE58\uB2E4."
    en: 
  - key: DTxt_KR_T_25
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC790, \uCC45\uC744 \uD558\uB098 \uC904 \uD14C\uB2C8\uAE4C \uC798 \uC0B4\uD3B4\uBD10"
    en: 
  - key: DTxt_KR_T_26
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD \uBC84\uD2BC\uC744 \uC774\uC6A9\uD558\uBA74
      \uB3CC\uB824\uBCFC \uC218 \uC788\uACE0, \uC67C\uCABD \uBC84\uD2BC\uC744 \uD074\uB9AD\uD558\uBA74
      \uCC45\uC744 \uC5F4\uC5B4\uBCFC \uC218 \uC788\uB2E4."
    en: 
  - key: DTxt_KR_T_27
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uCE7C\uC774 \uB4E4\uC5B4 \uC788\uC9C0?"
    en: 
  - key: DTxt_KR_T_28
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC774\uB7F0 \uC2DD\uC73C\uB85C \uC8C4\uC218 \uB188\uB4E4\uC740 \uBA40\uCA61\uD55C
      \uBB3C\uAC74\uC5D0 \uC704\uD5D8\uD55C \uAC83\uB4E4\uC744 \uC228\uACA8 \uB193\uB294\uB2E4."
    en: 
  - key: DTxt_KR_T_29
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uADF8\uB0E5 \uAC89\uBCF4\uAE30\uC5D0 \uC774\uC0C1 \uC5C6\uB2E4\uACE0 \uAD1C\uCC2E\uAD6C\uB098-
      \uD588\uB2E4\uAC00\uB294 \uBC14\uB85C (\uBAA9 \uAE0B\uB294 \uC2DC\uB289) \uC798\uB9AC\uB294
      \uAC70\uC9C0."
    en: 
  - key: DTxt_KR_T_30
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uADF8\uB798\uC11C \uB208\uCE58\uB97C \uC798 \uCC44\uC57C \uD574. \uBB50\uAC00
      \uC774\uC0C1\uD55C\uC9C0, \uBB50\uAC00 \uBA40\uCA61\uD55C \uAC74\uC9C0 \uC798
      \uD30C\uC545\uD558\uB294 \uAC8C \uC911\uC694\uD558\uAC70\uB4E0."
    en: 
  - key: DTxt_KR_T_31
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC790\uC2E0\uC774 \uC5C6\uB2E4\uBA74 \uADF8\uB0E5 \uAC10\uBC29 \uC548\uC744
      \uC0C5\uC0C5\uC774 \uB4A4\uC9C0\uB77C\uACE0."
    en: 
  - key: DTxt_KR_T_32
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uAC10\uBC29 \uAD6C\uC11D\uAD6C\uC11D, \uBCBD\uB3CC \uD558\uB098\uD558\uB098\uAE4C\uC9C0
      \uB2E4."
    en: 
  - key: DTxt_KR_T_33
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uADF8\uB798. \uB0B4\uAC00 \uC598\uAE30\uD574\uC904 \uC218 \uC788\uB294
      \uAC74 \uB300\uCDA9 \uC774 \uC815\uB3C4\uB2E4."
    en: 
  - key: DTxt_KR_T_34
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uB2F9\uC7A5 \uC77C\uC190\uC774 \uBD80\uC871\uD558\uB2C8, \uB354 \uAC00\uB974\uCCD0\uC904
      \uC2DC\uAC04 \uB530\uC704\uB294 \uC5C6\uB2E8 \uB9D0\uC774\uC9C0."
    en: 
  - key: DTxt_KR_T_35
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uB098\uBA38\uC9C0\uB294 \uAD6C\uB974\uBA74\uC11C \uBC30\uC6CC\uB77C."
    en: 
  - key: DTxt_KR_T_36
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC18C\uC7A5\uB2D8\uAED8 \uB9D0\uC744 \uAC78\uC5B4\uC11C \uB124\uAC00 \uC624\uB298
      \uD574\uC57C \uD558\uB294 \uBBF8\uC158\uC744 \uCCB4\uD06C\uD558\uACE0, \uC9C1\uC811
      \uC77C\uD574\uBCF4\uB77C\uACE0."
    en: 
  - key: DTxt_KR_T_37
    speaker: Frank
    mission: Tutorial
    type: Dialogue
    ko: "\uC880 \uC624\uB798 \uBC84\uD168\uC11C \uB124 \uC4F8\uBAA8\uB97C \uC99D\uBA85\uD574\uBD10."
    en: 
  - key: DTxt_KR_M01_01
    speaker: Victor
    mission: Mission01
    type: Dialogue
    ko: "\uC790\uB124\uB3C4 \uB4E4\uB9AC\uB098?"
    en: 
  - key: DTxt_KR_M01_02
    speaker: Victor
    mission: Mission01
    type: Dialogue
    ko: "\uBA4D\uCCAD\uD55C \uC8C4\uC218\uB4E4\uC774 \uC5EC\uAE30\uAC00 \uAD50\uB3C4\uC18C\uC778
      \uAC83\uB3C4 \uC78A\uACE0 \uB610 \uC2DC\uB044\uB7FD\uAC8C \uAD6C\uB294\uAD70"
    en: 
  - key: DTxt_KR_M01_03
    speaker: Victor
    mission: Mission01
    type: Dialogue
    ko: "\uC774\uB300\uB85C \uB194\uB450\uBA74 \uC2DC\uB044\uB7EC\uC6B4 \uD2C8\uC744
      \uD0C0\uC11C \uC218\uC0C1\uD55C \uC9D3\uC744 \uD558\uB294 \uB188\uC774 \uC0DD\uAE38
      \uAC8C \uBD84\uBA85\uD574"
    en: 
  - key: DTxt_KR_M01_04
    speaker: Victor
    mission: Mission01
    type: Dialogue
    ko: "\uAC00\uC11C \uC2DC\uB044\uB7FD\uAC8C \uD558\uB294 \uB188\uB4E4\uC744 \uB2E4
      \uB450\uB4E4\uACA8 \uD328\uACE0 \uC624\uAC8C"
    en: 
  - key: DTxt_KR_M01_05
    speaker: Victor
    mission: Mission01
    type: Dialogue
    ko: "\uB2E4 \uC870\uC6A9\uD788 \uC2DC\uCF30\uB098?"
    en: 
  - key: DTxt_KR_M01_06
    speaker: Victor
    mission: Mission01
    type: Dialogue
    ko: "\uD558\uC5EC\uD2BC \uD328\uC57C\uB9CC \uB9D0\uC744 \uB4E3\uB294\uB2E8 \uB9D0\uC774\uC9C0"
    en: 
  - key: DTxt_KR_M01_07
    speaker: Victor
    mission: Mission01
    type: Dialogue
    ko: "\uC8C4\uC218\uB4E4\uC744 \uC870\uC6A9\uD788 \uC2DC\uD0A4\uB294 \uAC83\uC870\uCC28
      \uBABB \uD574\uC11C\uC57C \uC5B4\uCA4C\uC790\uB294 \uAC74\uAC00? \uC790\uB124\uB294
      \uD574\uACE0\uC77C\uC138!"
    en: 
  - key: DTxt_KR_M02_01
    speaker: Victor
    mission: Mission02
    type: Dialogue
    ko: "\uC950\uC0C8\uB07C\uAC00 \uC815\uBCF4\uB97C \uAC00\uC838\uC654\uB2E4. \uC8C4\uC218
      \uB188\uB4E4\uC774 \uAC10\uBC29 \uC548\uC5D0 \uBB34\uAE30\uB97C \uC228\uACA8
      \uB1A8\uB2E4\uB294\uAD70."
    en: 
  - key: DTxt_KR_M02_02
    speaker: Victor
    mission: Mission02
    type: Dialogue
    ko: "\uBC16\uC5D0\uC11C\uB3C4 \uC0AC\uACE0 \uCCD0\uC11C \uB4E4\uC5B4\uC628 \uB188\uB4E4\uC774
      \uB610 \uBB34\uAE30\uB85C \uC0AC\uACE0\uB97C \uCE58\uB824\uACE0 \uD574?"
    en: 
  - key: DTxt_KR_M02_03
    speaker: Victor
    mission: Mission02
    type: Dialogue
    ko: "\uADF8\uB807\uAC8C\uB294 \uBABB \uB450\uC9C0"
    en: 
  - key: DTxt_KR_M02_04
    speaker: Victor
    mission: Mission02
    type: Dialogue
    ko: "\uAC10\uBC29\uC744 \uC0C5\uC0C5\uC774 \uB4A4\uC838\uC11C \uC804\uBD80 \uC555\uC218\uD574
      \uC640."
    en: 
  - key: DTxt_KR_M02_05
    speaker: Victor
    mission: Mission02
    type: Dialogue
    ko: "\uBB34\uAE30\uB97C \uC804\uBD80 \uCC3E\uC558\uB098?"
    en: 
  - key: DTxt_KR_M02_06
    speaker: Victor
    mission: Mission02
    type: Dialogue
    ko: "\uC5B4\uD734, \uC801\uC5B4\uB3C4 \uC624\uB298\uC740 \uBB34\uAE30 \uB54C\uBB38\uC5D0
      \uC0AC\uACE0\uB0A0 \uC77C\uC740 \uC5C6\uACA0\uAD70."
    en: 
  - key: DTxt_KR_M02_07
    speaker: Victor
    mission: Mission02
    type: Dialogue
    ko: "\uC790\uB124\uAC00 \uB193\uCE5C \uBB34\uAE30 \uB54C\uBB38\uC5D0 \uC8C4\uC218
      \uD55C\uBA85\uC774 \uC2E4\uB824\uB098\uAC14\uC5B4! \uC790\uB124\uB294 \uD574\uACE0\uC77C\uC138."
    en: 
  - key: DTxt_KR_M03_01
    speaker: Victor
    mission: Mission03
    type: Dialogue
    ko: "\uC774 \uBE4C\uC5B4\uBA39\uC744 7\uAD6C\uC5ED\uC5D0\uB294 \uB300\uCCB4 \uBB34\uC2A8
      \uBB38\uC81C\uAC00 \uC788\uB294 \uAC78\uAE4C?"
    en: 
  - key: DTxt_KR_M03_02
    speaker: Victor
    mission: Mission03
    type: Dialogue
    ko: "\uAD50\uB3C4\uC18C\uC5D0 \uB4E4\uC5B4\uC624\uC790\uB9C8\uC790 \uD5C8\uD2BC
      \uC9D3\uAC70\uB9AC\uB97C \uD558\uB294 \uB188\uB4E4\uC774 \uB9CE\uB2E8 \uB9D0\uC774\uC9C0."
    en: 
  - key: DTxt_KR_M03_03
    speaker: Victor
    mission: Mission03
    type: Dialogue
    ko: "\uC624\uB298 \uC0C8\uB85C \uB4E4\uC5B4\uC628 \uB188\uB4E4\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uB2E4.
      \uBD84\uC704\uAE30 \uBABB \uC77D\uACE0 \uC774\uC0C1\uD55C \uC9D3\uAC70\uB9AC\uB97C
      \uD558\uB294 \uB188\uB4E4\uC774 \uC788\uC744 \uAC8C \uBD84\uBA85\uD574."
    en: 
  - key: DTxt_KR_M03_04
    speaker: Victor
    mission: Mission03
    type: Dialogue
    ko: "\uAD50\uB3C4\uC18C\uB97C \uC21C\uCC30\uD558\uBA74\uC11C, \uC774\uC0C1\uD55C
      \uC9D3\uAC70\uB9AC\uB97C \uD558\uB294 \uB188\uB4E4\uC774 \uC788\uC73C\uBA74
      \uC804\uBD80 \uB450\uB4E4\uACA8 \uD328\uACE0 \uC640."
    en: 
  - key: DTxt_KR_M03_05
    speaker: Victor
    mission: Mission03
    type: Dialogue
    ko: "\uC774\uC0C1\uD55C \uC8C4\uC218\uB4E4\uC740 \uC804\uBD80 \uB450\uB4E4\uACA8
      \uD328\uACE0 \uC654\uB098?"
    en: 
  - key: DTxt_KR_M03_06
    speaker: Victor
    mission: Mission03
    type: Dialogue
    ko: "\uC0DD\uAC01\uBCF4\uB2E4 \uC2F8\uC6C0 \uC880 \uD558\uB294\uAD70?"
    en: 
  - key: DTxt_KR_M03_07
    speaker: Victor
    mission: Mission03
    type: Dialogue
    ko: "\uB9DB\uC774 \uAC04 \uB188\uB4E4\uB9CC \uB450\uB4E4\uACA8 \uD328\uACE0 \uC624\uB77C\uB294
      \uAC8C \uADF8\uB807\uAC8C \uC5B4\uB824\uC6E0\uB098? \uC790\uB124\uB294 \uD574\uACE0\uC77C\uC138!"
    en: 
  - key: DTxt_KR_M04_01
    speaker: Victor
    mission: Mission04
    type: Dialogue
    ko: "\uBC8C\uC368 \uC790\uB124\uAC00 \uCD9C\uADFC\uD560 \uC2DC\uAC04\uC778\uAC00?
      \uC544\uC9C1 \uD504\uB7AD\uD06C\uAC00 \uC548 \uC654\uB294\uB370?"
    en: 
  - key: DTxt_KR_M04_02
    speaker: Victor
    mission: Mission04
    type: Dialogue
    ko: "\uC774\uAC70 \uC774\uC0C1\uD558\uAD70. \uC790\uB124, \uD504\uB7AD\uD06C\uAC00
      \uC5B4\uB514 \uAC14\uB294\uC9C0 \uC544\uB098?"
    en: 
  - key: DTxt_KR_M04_03
    speaker: Victor
    mission: Mission04
    type: Dialogue
    ko: "\uBD84\uBA85 \uC544\uAE4C \uC21C\uCC30\uD558\uB7EC \uAC14\uB294\uB370, \uC544\uC9C1\uB3C4
      \uB3CC\uC544\uC624\uC9C0 \uC54A\uC558\uB2E4\uB2C8."
    en: 
  - key: DTxt_KR_M04_04
    speaker: Victor
    mission: Mission04
    type: Dialogue
    ko: "\uAD50\uB3C4\uC18C\uB85C \uB0B4\uB824\uAC00\uC11C \uD504\uB7AD\uD06C\uB97C
      \uCC3E\uC544\uBCF4\uAC8C."
    en: 
  - key: DTxt_KR_M04_05
    speaker: Victor
    mission: Mission04
    type: Dialogue
    ko: "\uD504\uB7AD\uD06C\uB97C \uCC3E\uC558\uB098?"
    en: 
  - key: DTxt_KR_M04_06
    speaker: Victor
    mission: Mission04
    type: Dialogue
    ko: "\uBB50? \uC8C4\uC218\uB4E4\uC774 \uD504\uB7AD\uD06C\uB85C \uBCC0\uC7A5\uD558\uACE0
      \uC788\uC5C8\uB2E4\uACE0? \uC774\uC81C\uB294 \uBCC4 \uC9D3\uC744 \uB2E4 \uD558\uB294\uAD70."
    en: 
  - key: DTxt_KR_M04_07
    speaker: Victor
    mission: Mission04
    type: Dialogue
    ko: "\uBB50? \uC8C4\uC218\uB791 \uD504\uB7AD\uD06C\uB97C \uD5F7\uAC08\uB838\uB2E4\uACE0?
      \uC790\uB124 \uB208\uC740 \uC7A5\uC2DD\uC778\uAC00? \uC790\uB124\uB294 \uD574\uACE0\uC57C!"
    en: 
  - key: DTxt_KR_M04_08
    speaker: Frank
    mission: Mission04
    type: Dialogue
    ko: "\uC870\uAE08\uB9CC \uB2A6\uC5C8\uC5B4\uB3C4 \uB0B4 \uBA38\uB9AC\uD1B5\uC774
      \uB0A0\uC544\uAC08 \uBED4\uD588\uB2E4. \uB2E4\uD589\uD788 \uB208\uCE58\uB294
      \uCC59\uACBC\uB098 \uBD10, \uC2E0\uCC38?"
    en: 
  - key: DTxt_KR_M04_09
    speaker: Frank
    mission: Mission04
    type: Dialogue
    ko: "\uB108 \uC9C0\uAE08 \uB204\uAD74 \uB54C\uB9AC\uB294 \uAC70\uC57C \uBA4D\uCCAD\uC544!"
    en: 
  - key: DTxt_KR_M05_01
    speaker: Victor
    mission: Mission05
    type: Dialogue
    ko: "\uC2AC\uC2AC \uC18C\uC9C0\uD488 \uAC80\uC0AC\uB97C \uD560 \uB54C\uAC00 \uB410\uB098?"
    en: 
  - key: DTxt_KR_M05_02
    speaker: Victor
    mission: Mission05
    type: Dialogue
    ko: "\uC544\uAE4C \uBCF4\uB2C8\uAE4C \uAD50\uB3C4\uC18C \uC548\uC5D0 \uC788\uC5B4\uC11C\uB294
      \uC548 \uB420 \uAC83\uB4E4\uC774 \uB3CC\uC544\uB2E4\uB2C8\uB354\uB780 \uB9D0\uC774\uC9C0."
    en: 
  - key: DTxt_KR_M05_03
    speaker: Victor
    mission: Mission05
    type: Dialogue
    ko: "\uC774\uAC83\uB4E4\uC774 \uB098\uB97C \uC544\uC8FC \uC6B0\uC2B5\uAC8C \uC544\uB294
      \uBAA8\uC591\uC774\uC57C."
    en: 
  - key: DTxt_KR_M05_04
    speaker: Victor
    mission: Mission05
    type: Dialogue
    ko: "\uAD50\uB3C4\uC18C\uC5D0 \uC788\uC5B4\uC11C\uB294 \uC548 \uB420 \uBB3C\uD488\uB4E4\uC744
      \uC804\uBD80 \uC555\uC218\uD558\uACE0 \uC640!"
    en: 
  - key: DTxt_KR_M05_05
    speaker: Victor
    mission: Mission05
    type: Dialogue
    ko: "\uC8C4\uC218\uB4E4\uC774 \uC228\uACA8\uB454 \uAE08\uC9C0 \uBB3C\uD488\uB4E4\uC740
      \uCC3E\uC558\uB098?"
    en: 
  - key: DTxt_KR_M05_06
    speaker: Victor
    mission: Mission05
    type: Dialogue
    ko: "\uC815\uB9D0\uC774\uC9C0, \uC5B4\uB514\uC11C \uACC4\uC18D \uB4E4\uC5EC\uC624\uB294
      \uAC74\uC9C0 \uBAA8\uB974\uACA0\uC5B4."
    en: 
  - key: DTxt_KR_M05_07
    speaker: Victor
    mission: Mission05
    type: Dialogue
    ko: "\uC790\uB124 \uAC19\uC740 \uAD50\uB3C4\uAD00\uB4E4 \uB54C\uBB38\uC5D0 \uC8C4\uC218\uB4E4\uC774
      \uB098\uB97C \uB9CC\uB9CC\uD558\uAC8C \uBCF4\uB294 \uAC70\uACA0\uC9C0. \uBB34\uB2A5\uD55C
      \uC790\uB124\uB294 \uD574\uACE0\uC57C!"
    en: 
  - key: DTxt_KR_M06_01
    speaker: Victor
    mission: Mission06
    type: Dialogue
    ko: "\uC81C\uC815\uC2E0\uC774 \uC544\uB2C8\uAD70, \uC81C\uC815\uC2E0\uC774 \uC544\uB2C8\uC57C."
    en: 
  - key: DTxt_KR_M06_02
    speaker: Victor
    mission: Mission06
    type: Dialogue
    ko: "\uC81C 7\uAD6C\uC5ED\uC5D0 \uC218\uAC10 \uC911\uC778 \uAC31 \uB188\uB4E4
      \uC911 \uD55C \uBA85\uC774 \uAD50\uB3C4\uC18C\uC5D0 \uCD1D\uAE30\uB97C \uBC00\uBC18\uC785\uD558\uB824\uB2E4
      \uAC78\uB9B0 \uD6C4, \uB3C4\uB9DD\uCCE4\uB2E4."
    en: 
  - key: DTxt_KR_M06_03
    speaker: Victor
    mission: Mission06
    type: Dialogue
    ko: "\uC6A9\uC758\uC790 3\uBA85 \uC911 1\uBA85\uC774 \uBC94\uC778\uC778 \uAC74
      \uD655\uC2E4\uD55C\uB370, \uC8C4\uB2E4 \uBE44\uC2B7\uD558\uAC8C \uC0DD\uACA8\uC11C
      \uB204\uAC00 \uBC94\uC778\uC778\uC9C0 \uC54C \uC218 \uC5C6\uB2E8 \uB9D0\uC774\uC9C0."
    en: 
  - key: DTxt_KR_M06_04
    speaker: Victor
    mission: Mission06
    type: Dialogue
    ko: "\uC8C4\uC218\uB4E4\uC740 \uB204\uAC00 \uBC94\uC778\uC778\uC9C0 \uC54C\uACE0
      \uC788\uACA0\uC9C0. \uC8C4\uC218\uB4E4\uC744 \uD611\uBC15\uD558\uB4E0, \uC124\uB4DD\uD558\uB4E0
      \uD574\uC11C \uC9C4\uC9DC \uBC94\uC778\uC744 \uCC3E\uC544\uB0B4!"
    en: 
  - key: DTxt_KR_M06_05
    speaker: Victor
    mission: Mission06
    type: Dialogue
    ko: "\uBC94\uC778\uC740 \uCC3E\uC558\uB098?"
    en: 
  - key: DTxt_KR_M06_06
    speaker: Victor
    mission: Mission06
    type: Dialogue
    ko: "\uAC10\uD788 \uC2E0\uC131\uD55C \uAD50\uB3C4\uC18C \uC548\uC5D0 \uCD1D\uAE30\uB97C
      \uB4E4\uC774\uB2E4\uB2C8, \uB0B4\uAC00 \uC9C1\uC811 \uAD50\uC721\uD558\uB3C4\uB85D
      \uD558\uACA0\uC5B4."
    en: 
  - key: DTxt_KR_M06_07
    speaker: Victor
    mission: Mission06
    type: Dialogue
    ko: "\uC790\uB124\uC758 \uCD94\uB9AC\uB294 \uD2C0\uB838\uC5B4! \uB610 \uCD1D\uAE30\uAC00
      \uBC1C\uACAC\uB410\uB2E4\uACE0! \uC774\uB807\uAC8C \uD5DB\uB2E4\uB9AC\uB97C
      \uC9DA\uB2E4\uB2C8. \uC790\uB124\uB294 \uD574\uACE0\uC57C!"
    en: 
  - key: DTxt_KR_M06_08
    speaker: Frank
    mission: Mission06
    type: Dialogue
    ko: "\uADF8\uB798, \uBC94\uC778\uC774 \uB204\uAD6C\uC778\uC9C0 \uC54C\uACA0\uB098?"
    en: 
  - key: DTxt_KR_M06_09
    speaker: Player
    mission: Mission06
    type: Choice
    ko: "\uBC94\uC778\uC740 \uC548\uD1A0\uB2C8\uB2E4."
    en: 
  - key: DTxt_KR_M06_10
    speaker: Player
    mission: Mission06
    type: Choice
    ko: "\uBC94\uC778\uC740 \uB9AC\uCC28\uB4DC\uB2E4"
    en: 
  - key: DTxt_KR_M06_11
    speaker: Player
    mission: Mission06
    type: Choice
    ko: "\uBC94\uC778\uC740 \uB808\uC624\uB2E4"
    en: 
  - key: DTxt_KR_M06_12
    speaker: Nick
    mission: Mission06
    type: Dialogue
    ko: "\uB0B4\uAC00 \uC598\uAE30\uD574\uC904 \uAC70 \uAC19\uC544?"
    en: 
  - key: DTxt_KR_M06_13
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uBC94\uC778\uC5D0 \uB300\uD574 \uC774\uC57C\uAE30\uD558\uC9C0 \uC54A\uC73C\uBA74
      \uB54C\uB9AC\uACA0\uB2E4."
    en: 
  - key: DTxt_KR_M06_14
    speaker: Nick
    mission: Mission06
    type: Dialogue
    ko: "Suspect3\uAC00 \uC138\uD0C1\uC2E4\uB85C \uB4E4\uC5B4\uAC00\uB294 \uAC78
      \uBD24\uB2E4 \uC815\uB3C4\uB294 \uC598\uAE30\uD574\uC918\uB3C4 \uB418\uACA0\uC9C0?"
    en: 
  - key: DTxt_KR_M06_15
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "Suspect3\uAC00 \uC138\uD0C1\uC2E4\uB85C \uB4E4\uC5B4\uAC14\uB2E4\uACE0?"
    en: 
  - key: DTxt_KR_M06_16
    speaker: Nick
    mission: Mission06
    type: Dialogue
    ko: "\uB204\uAC00 \uBC94\uC778\uC778\uC9C0 \uC598\uAE30\uD558\uB294 \uAC8C \uC544\uB2C8\uC796\uC544.
      \uADF8\uB807\uC9C0?"
    en: 
  - key: DTxt_KR_M06_17
    speaker: Bob
    mission: Mission06
    type: Dialogue
    ko: "\uAE00\uC384, \uC5B4\uC81C \uAC31\uB2E8\uC6D0 \uC911 \uB204\uAD70\uAC00\uAC00
      \uC815\uBE44\uC18C \uADFC\uCC98\uC5D0 \uC788\uB294 \uAC78 \uBCF8 \uAC83 \uAC19\uAE30\uB3C4
      \uD558\uACE0?"
    en: 
  - key: DTxt_KR_M06_18
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uC774\uBBF8 \uC54C\uACE0 \uC788\uB294 \uB0B4\uC6A9\uC774\uB2E4. \uB2E4\uB978
      \uC598\uAE30\uB97C \uD574\uBD10."
    en: 
  - key: DTxt_KR_M06_19
    speaker: Bob
    mission: Mission06
    type: Dialogue
    ko: "(\uC870\uC6A9\uD788)\uCD1D\uAE30\uB97C \uBC00\uBC18\uC785\uD55C \uADF8 \uB188\uC740
      \uBA38\uB9AC\uAC00 \uC544\uC8FC \uC9E7\uC544"
    en: 
  - key: DTxt_KR_M06_20
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uBA38\uB9AC\uAC00 \uC9E7\uACE0, \uB610?"
    en: 
  - key: DTxt_KR_M06_21
    speaker: Bob
    mission: Mission06
    type: Dialogue
    ko: "(\uC870\uC6A9\uD788)\uADF8 \uC774\uC0C1\uC740 \uBABB \uB9D0\uD574\uC918"
    en: 
  - key: DTxt_KR_M06_22
    speaker: Jerry
    mission: Mission06
    type: Dialogue
    ko: "\uCD1D? \uADF8\uB7F0 \uAC74 \uBAA8\uB974\uACA0\uACE0 \uD1B0\uC774\uB098
      \uC5B4\uB5BB\uAC8C \uD574\uBD10. \uB9E4\uC77C \uB098\uB97C \uAD34\uB86D\uD78C\uB2E4\uACE0."
    en: 
  - key: DTxt_KR_M06_23
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uD1B0? \uD1B0\uC740 \uC65C?"
    en: 
  - key: DTxt_KR_M06_24
    speaker: Jerry
    mission: Mission06
    type: Dialogue
    ko: "\uC5B4\uC81C\uB3C4 \uD1B0\uC744 \uD53C\uD574\uC11C \uC815\uBE44\uC18C \uADFC\uCC98\uC5D0
      \uC228\uC5B4 \uC788\uB2E4\uAC00 Suspect1\uC640 Suspect2\uB97C \uBD24\uC5B4"
    en: 
  - key: DTxt_KR_M06_25
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "Suspect1\uC640 Suspect2\uAC00 \uAC19\uC774 \uC6C0\uC9C1\uC600\uB098? \uB450
      \uC0AC\uB78C\uC740 \uBB58 \uD558\uACE0 \uC788\uC5C8\uC9C0?"
    en: 
  - key: DTxt_KR_M06_26
    speaker: Jerry
    mission: Mission06
    type: Dialogue
    ko: "\uC11C\uB85C \uB2E4\uB978 \uC2DC\uAC04\uB300\uC5D0 \uBD24\uB294\uB370, \uB450
      \uB188\uC774 \uAC01\uC790 \uBB58 \uD588\uB294\uC9C0\uB294 \uB098\uB3C4 \uBAB0\uB77C"
    en: 
  - key: DTxt_KR_M06_27
    speaker: Joe
    mission: Mission06
    type: Dialogue
    ko: "\uC5B4\uC81C \uBB58 \uD558\uACE0 \uC788\uC5C8\uB0D0\uACE0 \uBB3C\uC5B4\uBCF4\uBA74,
      \uC5B4\uC81C\uB294 \uAC00\uC2B4\uC744 \uD588\uC9C0."
    en: 
  - key: DTxt_KR_M06_28
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uAC00\uC2B4?"
    en: 
  - key: DTxt_KR_M06_29
    speaker: Joe
    mission: Mission06
    type: Dialogue
    ko: "\uB0A8\uC790\uB294 \uAC00\uC2B4\uC774\uB77C\uACE0. \uC5B4\uC81C Suspect2\uB3C4
      \uB098\uB791 \uAC19\uC774 \uC6B4\uB3D9\uC744 \uD588\uC5B4."
    en: 
  - key: DTxt_KR_M06_30
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uB458\uC774 \uBB34\uC2A8 \uB300\uD654\uB97C \uD588\uC9C0?"
    en: 
  - key: DTxt_KR_M06_31
    speaker: Joe
    mission: Mission06
    type: Dialogue
    ko: "Suspect2\uC5D0\uAC8C \uBAB8\uC744 \uC880 \uB354 \uD0A4\uC6CC\uC57C \uD560
      \uAC70 \uAC19\uB2E4\uACE0 \uD588\uB354\uB2C8, \uD654\uB97C \uB0B4\uB354\uB77C\uACE0"
    en: 
  - key: DTxt_KR_M06_32
    speaker: Tom
    mission: Mission06
    type: Dialogue
    ko: "\uC815\uBE44\uC18C \uADFC\uCC98\uC5D0\uC11C \uB3CC\uC544\uB2E4\uB2C8\uB294
      \uAC31\uB2E8\uC6D0\uC744 \uBCF8 \uC801 \uC788\uB0D0\uACE0?"
    en: 
  - key: DTxt_KR_M06_33
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uADF8\uB798, \uC218\uC0C1\uD55C \uB188\uC740 \uC5C6\uC5C8\uB098?"
    en: 
  - key: DTxt_KR_M06_34
    speaker: Tom
    mission: Mission06
    type: Dialogue
    ko: "\uC815\uBE44\uC18C\uB77C, \uC6B4\uB3D9\uC7A5 \uADFC\uCC98\uC5D0 \uC815\uBE44\uC18C\uAC00
      \uC788\uAE30\uB294 \uD558\uC9C0."
    en: 
  - key: DTxt_KR_M06_35
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uB204\uAC00 \uBC94\uC778\uC778\uC9C0 \uBD24\uAD70?"
    en: 
  - key: DTxt_KR_M06_36
    speaker: Tom
    mission: Mission06
    type: Dialogue
    ko: "\uB0B4\uAC00 \uBCF8 \uB140\uC11D\uC740 \uC637\uC744 \uC785\uC5B4\uB3C4 \uAC00\uB9B4
      \uC218 \uC5C6\uB294 \uACF3\uC5D0 \uBB38\uC2E0\uC744 \uC0C8\uACA8\uB480\uC5B4.
      \uBAA9\uC774\uB098 \uAC00\uC2B4\uCC98\uB7FC."
    en: 
  - key: DTxt_KR_M06_37
    speaker: Dave
    mission: Mission06
    type: Dialogue
    ko: "\uBC00\uBC18\uC785? \uADF8\uAC8C 7\uAD6C\uC5ED\uC5D0\uC11C \uD558\uB8E8
      \uC774\uD2C0\uC778\uAC00?"
    en: 
  - key: DTxt_KR_M06_38
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uC77C\uBC18\uC801\uC778 \uBC00\uBC18\uC785\uC774 \uC544\uB2C8\uB77C \uCD1D\uAE30
      \uBC00\uBC18\uC785\uC774\uB2E4. \uC2EC\uAC01\uD55C \uBB38\uC81C\uB77C\uACE0."
    en: 
  - key: DTxt_KR_M06_39
    speaker: Dave
    mission: Mission06
    type: Dialogue
    ko: "\uADF8\uB7F0 \uC2DC\uB2F5\uC796\uC740 \uC77C \uB9D0\uACE0 \uB0B4 \uADFC\uC721\uC774\uB098
      \uAD6C\uACBD\uD558\uB77C\uACE0. \uC544\uB984\uB2F5\uC9C0?"
    en: 
  - key: DTxt_KR_M06_40
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uBC94\uC778\uC5D0 \uB300\uD55C \uC815\uBCF4\uB098 \uC81C\uACF5\uD574\uB77C."
    en: 
  - key: DTxt_KR_M06_41
    speaker: Dave
    mission: Mission06
    type: Dialogue
    ko: "\uC544\uBB34\uB798\uB3C4 \uCD1D\uC744 \uC3D8\uB824\uBA74, \uB208\uC774 \uBA40\uCA61\uD574\uC57C\uC9C0.
      \uB208\uC5D0 \uD749\uD130 \uB530\uC704\uB294 \uC5C6\uC744 \uAC70\uC57C."
    en: 
  - key: DTxt_KR_M06_42
    speaker: Chris
    mission: Mission06
    type: Dialogue
    ko: "\uAC10\uC625\uC5D0\uC11C \uAC19\uC740 \uC8C4\uC218\uB97C \uBC00\uACE0\uD55C
      \uB188\uB4E4\uC774 \uC5B4\uB5BB\uAC8C \uB418\uB294\uC9C0 \uC544\uB098?"
    en: 
  - key: DTxt_KR_M06_43
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uC5B4\uB5BB\uAC8C \uB418\uB294\uB370?"
    en: 
  - key: DTxt_KR_M06_44
    speaker: Chris
    mission: Mission06
    type: Dialogue
    ko: "\uB054\uCC0D\uD558\uAC8C \uC0B4\uD574 \uB2F9\uD55C\uB2E4. \uBC30\uC2E0\uC790\uB77C\uACE0."
    en: 
  - key: DTxt_KR_M06_45
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uC6B0\uB9AC\uAC00 \uBCF4\uD638\uD574\uC904 \uC218 \uC788\uC5B4."
    en: 
  - key: DTxt_KR_M06_46
    speaker: Chris
    mission: Mission06
    type: Dialogue
    ko: "\uC0AC\uAE30\uAFBC\uC5D0\uAC8C \uC0AC\uAE30\uB97C \uCE58\uB824\uACE0 \uD558\uB294\uAD70.
      \uB0B4\uAC00 \uB9D0\uD574\uC904 \uC218 \uC788\uB294 \uAC74 \uC5C6\uC5B4."
    en: 
  - key: DTxt_KR_M06_47
    speaker: Mike
    mission: Mission06
    type: Dialogue
    ko: "\uB0B4\uAC00 \uCD1D\uAE30\uC5D0 \uAD00\uD574 \uC870\uAE08 \uC544\uB294 \uAC8C
      \uC788\uB294\uB370 \uB9D0\uC774\uC57C."
    en: 
  - key: DTxt_KR_M06_48
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uBB50\uC9C0?"
    en: 
  - key: DTxt_KR_M06_49
    speaker: Mike
    mission: Mission06
    type: Dialogue
    ko: "\uC804\uAC08 \uAC31\uB2E8 \uB188\uB4E4\uC740 \uCD1D\uAE30\uB97C \uC190\uC9C8\uD560
      \uB54C \uD30C\uB780\uC0C9 \uC624\uC77C\uC744 \uC0AC\uC6A9\uD574."
    en: 
  - key: DTxt_KR_M06_50
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uD30C\uB780\uC0C9?"
    en: 
  - key: DTxt_KR_M06_51
    speaker: Mike
    mission: Mission06
    type: Dialogue
    ko: "\uC5B4\uCA4C\uBA74 \uADF8 \uD754\uC801\uC774 \uBC94\uC778\uD55C\uD14C \uB0A8\uC544
      \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB974\uC9C0."
    en: 
  - key: DTxt_KR_M06_52
    speaker: Paul
    mission: Mission06
    type: Dialogue
    ko: "\uC5B4\uC81C\uB294 \uD558\uB8E8 \uC885\uC77C \uCC45\uC744 \uC77D\uACE0 \uC788\uC5C8\uAE30
      \uB54C\uBB38\uC5D0 \uC815\uBE44\uC18C\uC5D0\uC11C \uBB34\uC2A8 \uC77C\uC774
      \uC788\uC5C8\uB294\uC9C0 \uBAB0\uB77C."
    en: 
  - key: DTxt_KR_M06_53
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uBC94\uC778\uC5D0 \uB300\uD574 \uC544\uB294 \uAC8C \uC5C6\uB098?"
    en: 
  - key: DTxt_KR_M06_54
    speaker: Paul
    mission: Mission06
    type: Dialogue
    ko: "\uD558\uC9C0\uB9CC, \uC5B4\uC81C \uAE09\uD558\uAC8C \uB2EC\uB824\uAC00\uB358
      \uAC31\uB2E8\uC6D0\uACFC \uBD80\uB52A\uD78C \uAE30\uC5B5\uC774 \uC788\uAE30\uB294
      \uD574."
    en: 
  - key: DTxt_KR_M06_55
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uC5B4\uB5A4 \uB140\uC11D\uC774\uC5C8\uC9C0?"
    en: 
  - key: DTxt_KR_M06_56
    speaker: Paul
    mission: Mission06
    type: Dialogue
    ko: "\uC0AD\uBC1C\uD55C \uBA38\uB9AC\uC600\uB358 \uAC70 \uAC19\uAE30\uB3C4 \uD558\uACE0,
      \uC544\uB2CC \uAC70 \uAC19\uAE30\uB3C4 \uD558\uACE0."
    en: 
  - key: DTxt_KR_M06_57
    speaker: Suspect1
    mission: Mission06
    type: Dialogue
    ko: "\uB0B4\uAC00 \uD3C9\uC0C1\uC2DC\uC5D0 \uC815\uBE44\uC18C\uC5D0\uC11C \uC77C\uD558\uAE30\uB294
      \uD558\uC9C0\uB9CC, \uC5B4\uC81C\uB294 \uC815\uBE44\uC18C \uADFC\uCC98\uC5D0\uB3C4
      \uC548 \uAC14\uC5B4."
    en: 
  - key: DTxt_KR_M06_58
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uADF8\uB7EC\uBA74 \uBB58 \uD588\uC9C0?"
    en: 
  - key: DTxt_KR_M06_59
    speaker: Suspect1
    mission: Mission06
    type: Dialogue
    ko: "\uC5B4\uC81C\uB294 \uBAB8\uC774 \uC548 \uC88B\uC544\uC11C \uADF8\uB0E5 \uAC10\uBC29\uC5D0\uC11C
      \uC26C\uC5C8\uB2E4\uACE0."
    en: 
  - key: DTxt_KR_M06_60
    speaker: Suspect2
    mission: Mission06
    type: Dialogue
    ko: "\uB09C \uC5B4\uC81C \uC6B4\uB3D9\uC7A5\uC5D0\uC11C \uBCA4\uCE58 \uD504\uB808\uC2A4\uB9CC
      \uD588\uC5B4. \uAE30\uB85D \uAC31\uC2E0\uC5D0 \uC2E4\uD328\uD588\uC9C0."
    en: 
  - key: DTxt_KR_M06_61
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uB108\uC758 \uC6B4\uB3D9 \uBA54\uC774\uD2B8\uB294 \uB204\uAD6C\uC600\uC9C0?"
    en: 
  - key: DTxt_KR_M06_62
    speaker: Suspect2
    mission: Mission06
    type: Dialogue
    ko: "\uB369\uCE58 \uD070 \uC870\uD55C\uD14C \uBB3C\uC5B4\uBD10. \uB0B4 \uC22B\uC790\uB97C
      \uC138\uC900 \uAC8C \uADF8 \uB188\uC774\uB2C8\uAE4C."
    en: 
  - key: DTxt_KR_M06_63
    speaker: Suspect3
    mission: Mission06
    type: Dialogue
    ko: "\uB09C \uC5B4\uC81C \uC815\uBE44\uC18C \uADFC\uCC98\uC5D0\uB3C4 \uAC04 \uC801
      \uC5C6\uC5B4. \uC885\uC77C \uC138\uD0C1\uC2E4\uC5D0\uC11C \uC77C\uD588\uB2E4\uACE0."
    en: 
  - key: DTxt_KR_M06_64
    speaker: Player
    mission: Mission06
    type: Dialogue
    ko: "\uADF8\uAC78 \uC99D\uBA85\uD574\uC904 \uC218 \uC788\uB294 \uC0AC\uB78C\uC774
      \uC788\uB098?"
    en: 
  - key: DTxt_KR_M06_65
    speaker: Suspect3
    mission: Mission06
    type: Dialogue
    ko: "\uBD84\uBA85 \uB204\uAD70\uAC00\uB294 \uB0B4\uAC00 \uC138\uD0C1\uC18C\uC5D0\uC11C
      \uC77C\uD558\uB294 \uAC78 \uBD24\uC744\uAC78?"
    en: 
